#ruledef
{
    jmp {offset: addr_pcrel} =>
    {
        asm { rjmp {offset} }
    }

    jmp {target} =>
    {
        asm { ljmp {target} }
    }

    beq {offset: addr_pcrel} =>
    {
        asm { beqr {offset} }
    }

    beq {target} =>
    {
        asm { beql {target} }
    }

    bne {offset: addr_pcrel} =>
    {
        asm { bner {offset} }
    }

    bne {target} =>
    {
        asm { bnel {target} }
    }

    bcs {offset: addr_pcrel} =>
    {
        asm { bcsr {offset} }
    }

    bcs {target} =>
    {
        asm { bcsl {target} }
    }

    bcc {offset: addr_pcrel} =>
    {
        asm { bccr {offset} }
    }

    bcc {target} =>
    {
        asm { bccl {target} }
    }

    bmi {offset: addr_pcrel} =>
    {
        asm { bmir {offset} }
    }

    bmi {target} =>
    {
        asm { bmil {target} }
    }

    bpl {offset: addr_pcrel} =>
    {
        asm { bplr {offset} }
    }

    bpl {target} =>
    {
        asm { bpll {target} }
    }

    call {offset: addr_pcrel} =>
    {
        asm { rcall {offset} }
    }

    call {target} =>
    {
        asm { callf {target} }
    }
}
